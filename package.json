{
  "name": "tor-mcp",
  "version": "1.3.6",
  "type": "module",
  "description": "MCP server giving Cursor AI safe private access through a managed Tor daemon",
  "main": "server.mjs",
  "bin": {
    "tor-mcp": "./server.mjs"
  },
  "files": [
    "server.mjs",
    "usage-gate.mjs",
    "tor-daemon.mjs",
    "research.mjs",
    "torrc",
    "setup.ps1",
    "bin/",
    "scripts/",
    "aizamon-mcp/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jordymoney/tor-mcp.git"
  },
  "homepage": "https://aizamon.com/install/tor-mcp",
  "bugs": {
    "url": "https://github.com/jordymoney/tor-mcp/issues"
  },
  "keywords": [
    "mcp",
    "cursor",
    "tor",
    "privacy",
    "onion",
    "socks5",
    "osint",
    "aizamon",
    "claude"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.mjs",
    "setup": "powershell -ExecutionPolicy Bypass -File setup.ps1",
    "sweep": "node scripts/sweep-onions.mjs",
    "install:aizamon": "bash scripts/install-aizamon-mcp.sh",
    "smoke:aizamon": "node scripts/smoke-aizamon-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "node-fetch": "^3.3.2",
    "socks-proxy-agent": "^8.0.5",
    "zod": "^3.23.8"
  }
}
